# Copy to .env.local and fill in real values. .env.local is gitignored and
# only affects local dev - it is never read by the Vercel deployment, whose
# env vars are configured separately in the Vercel project dashboard.

# Used by src/lib/ai/groq-client.ts (seller-assistant, suggest-category,
# marketing-assistant features).
GROQ_API_KEY=

# Not currently used by any code in this repo - reserved for future use.
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
